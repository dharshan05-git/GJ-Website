    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "nodemailer": "^6.10.1",
    "razorpay": "^2.9.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.2.2"
