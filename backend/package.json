{
  "name": "gevariya-jewels-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API backend for GEVARIYA JEWELS — catalog, auth, cart, orders, payments and admin.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
