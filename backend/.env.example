# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,http://localhost:4173
# Used for links inside emails
SITE_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/gevariya_jewels
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/gevariya_jewels
MONGO_URI=mongodb://127.0.0.1:27017/gevariya_jewels

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── Owner account (created by `npm run seed`) ────────────
# Role: superadmin — can create staff/manager/admin accounts from the panel.
ADMIN_NAME=Gevariya Admin
ADMIN_EMAIL=admin@gevariyajewels.com
ADMIN_PASSWORD=Admin@12345

# ─── Razorpay (test keys from dashboard.razorpay.com) ─────
# Leave blank to run the API in COD-only mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional, only if you enable Razorpay webhooks
RAZORPAY_WEBHOOK_SECRET=

# ─── Email automation (SMTP) ──────────────────────────────
# Leave SMTP_HOST blank in development: emails go to an Ethereal test inbox and
# every message gets a preview link in the console and the admin panel.
#
# Brevo   : smtp-relay.brevo.com   : 587  (300 free emails/day)
# Zoho    : smtp.zoho.in           : 587
# SES     : email-smtp.<region>.amazonaws.com : 587
# Gmail   : smtp.gmail.com         : 587  (App Password, ~500/day)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GEVARIYA JEWELS <no-reply@gevariyajewels.com>
# Where "new order" alerts go (also editable from the admin panel)
ADMIN_ALERT_EMAIL=

# ─── Store rules (defaults; the admin panel overrides these) ──
FREE_SHIPPING_THRESHOLD=1500
SHIPPING_FEE=0
